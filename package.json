{
  "name": "@jupiterone/jupiterone-client-nodejs",
  "version": "2.1.2",
  "description": "A node.js client wrapper for JupiterOne public API",
  "repository": {
    "type": "git",
    "url": "https://github.com/JupiterOne/jupiterone-client-nodejs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "JupiterOne <dev@jupiterone.io>",
  "files": [
    "LICENSE",
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "j1": "bin/j1"
  },
  "scripts": {
    "env": "export $(grep -v '^#' .env | xargs);",
    "format": "prettier --write '**/*.{ts,js,json,css,md,yml}'",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --cache --fix --ext .ts,.tsx --max-warnings 27",
    "pretest": "npm run lint && npm run type-check",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "test:upsert": "npm run env; node src/j1cli.js -o upsert --entity --account $J1_ACCOUNT_ID --key $J1_API_TOKEN --input-file ./examples-yaml/entities.yml",
    "copydist": "cp -R LICENSE *.md package-lock.json package.json ./dist/",
    "distpackage": "(cd ./dist && sed -ibak -e 's#dist/inde[x]#index#g' package.json && rm package.jsonbak)",
    "prebuild": "npm test",
    "build": "tsc -p tsconfig.dist.json --declaration",
    "prepack": "npm run build",
    "prepare": "husky install",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@jupiterone/jupiterone-alert-rules": "^0.20.0",
    "@lifeomic/attempt": "^3.0.3",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^5.0.0",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "inquirer": "^8.2.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^2.6.7",
    "p-all": "^2.1.0",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@pollyjs/adapter-node-http": "^2.7.0",
    "@pollyjs/core": "^2.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.6.0",
    "husky": "^7.0.0",
    "jest": "^30.0.0",
    "lint-staged": "^12.3.3",
    "nock": "^14.0.0",
    "prettier": "^2.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.0"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:jest/recommended",
      "prettier"
    ],
    "env": {
      "node": true,
      "es6": true
    },
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "rules": {
      "@typescript-eslint/no-use-before-define": [
        "error",
        {
          "functions": false
        }
      ],
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/no-require-imports": "warn",
      "@typescript-eslint/no-var-requires": "warn",
      "@typescript-eslint/no-unused-vars": "warn"
    }
  },
  "prettier": {
    "trailingComma": "all",
    "proseWrap": "always",
    "singleQuote": true
  },
  "lint-staged": {
    "linters": {
      "*.{ts,js,json,css,md,yml}": [
        "npm run format",
        "git add"
      ]
    },
    "ignore": []
  }
}
